APP_NAME="Fiat Lux Document Request Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
STUDENT_REGISTRATION_REQUIRE_ROSTER=false

# Defaults to true when APP_ENV=production. Keep false for local HTTP only.
FORCE_HTTPS=false
HTTPS_HSTS_ENABLED=true
HTTPS_HSTS_MAX_AGE=31536000
# Enable only when every school subdomain supports HTTPS.
HTTPS_HSTS_INCLUDE_SUBDOMAINS=false

SCHOOL_FORMS_DB_DATABASE=generator/database/database.sqlite

# Set a separate random base64 key in production; APP_KEY is the fallback.
DOCUMENT_ISSUER="Fiat Lux Academe"
DOCUMENT_SIGNING_KEY=
DOCUMENT_ISSUER_LOGO=certificates/fla-seal.jpg
DOCUMENT_BLOCKCHAIN_DRIVER=

# Private X.509 signing material. Keep both files outside public/ and out of Git.
PDF_SIGN_CERT_PATH=
PDF_SIGN_KEY_PATH=
PDF_SIGN_KEY_PASSWORD=
PDF_SIGNER_NAME="Fiat Lux Academe Document Issuing System"
PDF_SIGN_REASON="Official school document issuance"
PDF_SIGN_LOCATION="Office of the Registrar"
# Usually only needed by Windows/XAMPP when OpenSSL cannot locate openssl.cnf.
PDF_SIGN_OPENSSL_CONFIG=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
HASH_VERIFY=true
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

# Use Redis in production so limits are shared by every application server.
AUTH_SECURITY_CACHE_STORE=redis
AUTH_ENDPOINT_ATTEMPTS_PER_MINUTE=30
AUTH_MINIMUM_FORM_FILL_SECONDS=2
AUTH_MAXIMUM_FORM_AGE_SECONDS=3600
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_LOCKOUT_MINUTES=15,30,60
AUTH_ANOMALY_WINDOW_MINUTES=15
AUTH_DISTINCT_IP_THRESHOLD=3
AUTH_DISTINCT_ACCOUNT_THRESHOLD=10
AUTH_ALERT_LOG_CHANNEL=security

# Create production keys in the Cloudflare dashboard. Never use test keys live.
TURNSTILE_ENABLED=true
TURNSTILE_USE_TEST_KEYS=true
TURNSTILE_TEST_SITE_KEY=1x00000000000000000000AA
TURNSTILE_TEST_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=login
TURNSTILE_ALLOWED_HOSTNAMES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SECURITY_LOG_LEVEL=notice
SECURITY_LOG_DAYS=90

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# These default to true in production and false during local development.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=fiat_lux_hub_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-sender@gmail.com"
MAIL_PASSWORD="your-google-app-password"
MAIL_FROM_ADDRESS="your-sender@gmail.com"
MAIL_FROM_NAME="Fiat Lux Academe"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
