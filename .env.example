APP_NAME="Fiat Lux Document Request Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SCHOOL_FORMS_DB_DATABASE=generator/database/database.sqlite

# Set a separate random base64 key in production; APP_KEY is the fallback.
DOCUMENT_ISSUER="Fiat Lux Academe"
DOCUMENT_SIGNING_KEY=
DOCUMENT_ISSUER_LOGO=certificates/fla-seal.jpg
DOCUMENT_BLOCKCHAIN_DRIVER=

# Private X.509 signing material. Keep both files outside public/ and out of Git.
PDF_SIGN_CERT_PATH=
PDF_SIGN_KEY_PATH=
PDF_SIGN_KEY_PASSWORD=
PDF_SIGNER_NAME="Fiat Lux Academe Document Issuing System"
PDF_SIGN_REASON="Official school document issuance"
PDF_SIGN_LOCATION="Office of the Registrar"
# Usually only needed by Windows/XAMPP when OpenSSL cannot locate openssl.cnf.
PDF_SIGN_OPENSSL_CONFIG=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=fiat_lux_hub_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
