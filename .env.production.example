APP_NAME="Fiat Lux Document Request Hub"
APP_ENV=production
APP_KEY=GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://records.example.edu.ph

FORCE_HTTPS=true
HTTPS_HSTS_ENABLED=true
HTTPS_HSTS_MAX_AGE=31536000
HTTPS_HSTS_INCLUDE_SUBDOMAINS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
SECURITY_LOG_LEVEL=notice
SECURITY_LOG_DAYS=90

DB_CONNECTION=sqlite
DB_DATABASE=/ABSOLUTE/PRIVATE/PATH/database.sqlite
SCHOOL_FORMS_DB_DATABASE=/ABSOLUTE/PRIVATE/PATH/school_forms.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=fiat_lux_hub_session

CACHE_STORE=redis
QUEUE_CONNECTION=database
WEB_RATE_LIMIT_PER_MINUTE=120
AUTH_SECURITY_CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=SET_A_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

TURNSTILE_ENABLED=true
TURNSTILE_USE_TEST_KEYS=false
TURNSTILE_SITE_KEY=SET_CLOUDFLARE_PRODUCTION_SITE_KEY
TURNSTILE_SECRET_KEY=SET_CLOUDFLARE_PRODUCTION_SECRET_KEY
TURNSTILE_EXPECTED_ACTION=login
TURNSTILE_ALLOWED_HOSTNAMES=records.example.edu.ph

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.edu.ph
MAIL_PORT=587
MAIL_USERNAME=SET_SMTP_USERNAME
MAIL_PASSWORD=SET_SMTP_PASSWORD
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=records@example.edu.ph
MAIL_FROM_NAME="Fiat Lux Academe"

FILESYSTEM_DISK=local
DOCUMENT_ISSUER="Fiat Lux Academe"
DOCUMENT_SIGNING_KEY=GENERATE_A_SEPARATE_RANDOM_BASE64_SECRET
DOCUMENT_ISSUER_LOGO=certificates/fla-seal.jpg
PDF_SIGN_CERT_PATH=/ABSOLUTE/PRIVATE/PATH/document-signing.crt
PDF_SIGN_KEY_PATH=/ABSOLUTE/PRIVATE/PATH/document-signing.key
PDF_SIGN_KEY_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
PDF_SIGNER_NAME="Fiat Lux Academe Document Issuing System"
PDF_SIGN_REASON="Official school document issuance"
PDF_SIGN_LOCATION="Office of the Registrar"

STUDENT_REGISTRATION_REQUIRE_ROSTER=true
